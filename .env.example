# ========================================
# CLUTCH DISCORD BOT - CONFIGURAÇÃO
# ========================================
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA versione o .env — ele contém segredos.

# --- DISCORD (OBRIGATÓRIO) ---
# Token do bot (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Prefixo dos comandos legados (!sync, !backup, !reload — só para o dono)
BOT_PREFIX=!

# --- SINCRONIZAÇÃO DE SLASH COMMANDS ---
# Servidor de desenvolvimento: com o ID preenchido, os comandos aparecem
# instantaneamente nele. Vazio = sync global (pode levar até 1 hora).
DEV_GUILD_ID=

# Sincronizar no boot. Deixe false se reinicia muito (o sync global tem
# rate limit apertado) e use !sync quando precisar.
AUTO_SYNC=true

# --- API HTTP DE CONTROLE ---
# ATENÇÃO: estes endpoints fazem o bot entrar em canais de voz e enviar
# mensagens em seu nome. Sem API_KEY, o servidor só sobe em 127.0.0.1.
# Para expor na rede (ex: Docker), defina API_KEY e API_HOST=0.0.0.0.
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
API_HOST=127.0.0.1
API_PORT=8080

# --- DOCKER COMPOSE (multi-agente) ---
# Usados apenas por docker-compose.yml
DISCORD_TOKEN_1=
DISCORD_TOKEN_2=
API_KEY_1=
API_KEY_2=

# --- GOOGLE GEMINI AI (opcional) ---
# API Key do Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_HISTORY_SIZE=5
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# --- CLUTCH PRESENCE BRIDGE ---
# Base URL do backend CLUTCH que receberá a ingestão de presença do Discord
CLUTCH_API_BASE_URL=http://localhost:3000

# Token interno enviado no header x-clutch-discord-ingest-token
CLUTCH_DISCORD_INGEST_TOKEN=

# Opcional: restringe a bridge a uma guild específica
CLUTCH_TARGET_GUILD_ID=

# Quando true, não envia POST; apenas registra o payload em log
CLUTCH_PRESENCE_DRY_RUN=true

# TTL simples para deduplicar eventos equivalentes
CLUTCH_PRESENCE_DEDUP_SECONDS=15

# Timeout total da request ao CLUTCH
CLUTCH_PRESENCE_REQUEST_TIMEOUT_SECONDS=5

# --- ÁUDIO / REDE ---
# IP do computador receptor para streaming de áudio
# Descubra seu IP local com: ipconfig (Windows) ou ip addr (Linux/Mac)
UDP_TARGET_IP=127.0.0.1

# Porta para enviar áudio capturado (receptor.py escuta aqui)
UDP_PORT_ENVIO=6000

# Porta onde o bot recebe áudio do microfone
UDP_PORT_RECEBIMENTO=6001

# Formato do áudio (padrão do Discord — só mude se souber o que faz)
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
AUDIO_CHUNK_SIZE=960

# Volumes iniciais do mixer (0.0 a 1.0)
MIXER_VOLUME_MIC=0.7
MIXER_VOLUME_FX=1.0

# Pasta do soundboard (usada por /sfx e pela API /play)
SOUNDS_DIR=assets/sfx

# --- BANCO DE DADOS ---
DB_PATH=data/clutch.db
DB_ENABLE_WAL=true
DB_TIMEOUT=10

# Backup automático diário (use !backup para gerar na hora)
DB_BACKUP_ENABLED=true
DB_BACKUP_DIR=backups
DB_BACKUP_KEEP=7

# --- GAMIFICAÇÃO ---
XP_PER_MESSAGE=10
XP_PER_VOICE_MINUTE=5
LEVEL_UP_MULTIPLIER=100
# Segundos entre ganhos de XP por mensagem (anti-spam)
XP_COOLDOWN=60

# --- LOGGING ---
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5
LOG_STRUCTURED=false

# --- DASHBOARD ---
DASHBOARD_PORT=8501
# URLs da API por agente (usadas pelo dashboard.py)
CLUTCH_API_URL_ALPHA=http://127.0.0.1:8080
CLUTCH_API_URL_BRAVO=http://127.0.0.1:8081
UDP_PORT_ALPHA=6001
UDP_PORT_BRAVO=6002

# --- DESENVOLVIMENTO ---
DEV_MODE=false
